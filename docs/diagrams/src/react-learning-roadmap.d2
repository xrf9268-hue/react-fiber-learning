direction: down

title: "React Fiber 学习路线总图" {
  style: {
    font-size: 22
    bold: true
    fill: "#f8fafc"
    stroke: "#f8fafc"
  }
}

roadmap: "" {
  grid-columns: 2
  grid-gap: 16
  style: {
    fill: "#ffffff"
    stroke: "#ffffff"
  }

  M1: "M1 为什么需要 Fiber\n问题：旧同步渲染\n为什么不够？\n结论：把渲染改造成\n可调度的工作系统" {
    class: emphasis-cyan
  }

  M2: "M2 Fiber 节点与遍历\n问题：工作单元\n长什么样？\n结论：child/sibling/return\n拆成显式工作节点" {
    class: emphasis-blue
  }

  M3: "M3 双树与 render/commit\n问题：如何准备下一版\n又保持界面稳定？\n结论：current 与 WIP 分工\ncommit 统一切换" {
    class: emphasis-orange
  }

  M4: "M4 一次更新全链路\n问题：setState 怎样\n走到 render/commit？\n结论：先登记\n再调度，再提交" {
    class: emphasis-purple
  }

  M5: "M5 lanes 与 scheduler\n问题：多批更新时\n先做什么？\n结论：lane 归类\nroot 选批次" {
    class: emphasis-green
  }

  M6: "M6 Suspense/Offscreen\n问题：做不下去时\n怎么处理？\n结论：suspend→fallback\n→ping→retry" {
    class: emphasis-red
  }
}

hint: "学习顺序：M1 → M2 → M3 → M4 → M5 → M6\n从问题意识到阻塞恢复机制的连续解释链" {
  class: note
}

title -> roadmap: "" {
  style: {
    stroke: "#ffffff"
    stroke-width: 0
  }
}
roadmap -> hint: "" {
  style: {
    stroke: "#ffffff"
    stroke-width: 0
  }
}
